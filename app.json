{
  "expo": {
    "name": "ColorFillOnline",
    "slug": "ColorFillOnlineUpdated",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ColorFill-iOS.png",
    "scheme": "colorfillonlineupdated",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.colorfillonlineupdated",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "hooks": {
        "postPrebuild": ["node ./scripts/copy-sounds.js"]
      }
    },
    "splash": {
      "image": "./assets/images/ColorFill-Splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#151718",
      "imageWidth": "200"
    },
    "notification": {
      "icon": "./assets/images/ColorFill-Android-Notification.png",
      "color": "#ffffff"
    },
    "android": {
      "googleServicesFile": "google-services.json",
      "package": "com.colorfillonlineupdated",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ColorFill-Android.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/ColorFill-Favicon.png",
      "indexHtmlPath": "./web/index.html"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/ColorFill-Android-Notification.png",
          "color": "#ffffff"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "495c2cc3-7384-4eaa-a937-648fad614abb"
      }
    },
    "owner": "satchmocodes"
  }
}
